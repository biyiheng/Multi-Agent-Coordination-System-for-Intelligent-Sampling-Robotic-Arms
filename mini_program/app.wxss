/* app.wxss - Global styles for Intelligent Sampling Robotic Arm Mini Program */

/* ===== CSS Variables / Color Constants ===== */
page {
  --primary: #07C160;
  --primary-dark: #06AD56;
  --danger: #FA5151;
  --danger-dark: #E04848;
  --warning: #FFC300;
  --warning-dark: #E6B000;
  --info: #1890FF;
  --bg-dark: #1a1a2e;
  --bg-card: #ffffff;
  --bg-page: #f5f5f5;
  --text-primary: #333333;
  --text-secondary: #666666;
  --text-muted: #999999;
  --border-color: #e8e8e8;
  --shadow: 0 2px 12px rgba(0, 0, 0, 0.08);

  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 28rpx;
  color: var(--text-primary);
  background-color: var(--bg-page);
  box-sizing: border-box;
}

/* ===== Status Colors ===== */
.status-ok { color: #07C160; }
.status-warning { color: #FFC300; }
.status-error { color: #FA5151; }
.status-info { color: #1890FF; }

/* ===== Layout Classes ===== */
.container {
  padding: 20rpx;
  min-height: 100vh;
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-center {
  display: flex;
  justify-content: center;
  align-items: center;
}

.flex-wrap {
  display: flex;
  flex-wrap: wrap;
}

.flex-1 { flex: 1; }
.flex-2 { flex: 2; }
.flex-3 { flex: 3; }

/* ===== Card Component ===== */
.card {
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--border-color);
}

/* ===== Button Styles ===== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  padding: 0 32rpx;
  border: none;
  transition: all 0.2s;
}

.btn-primary {
  background: var(--primary);
  color: #ffffff;
}

.btn-danger {
  background: var(--danger);
  color: #ffffff;
}

.btn-warning {
  background: var(--warning);
  color: #333333;
}

.btn-outline {
  background: transparent;
  border: 2rpx solid var(--primary);
  color: var(--primary);
}

.btn-small {
  height: 56rpx;
  font-size: 24rpx;
  padding: 0 20rpx;
}

.btn-large {
  height: 96rpx;
  font-size: 32rpx;
  padding: 0 48rpx;
}

.btn-disabled {
  opacity: 0.5;
  pointer-events: none;
}

.btn-block {
  width: 100%;
}

/* ===== Input Styles ===== */
.input {
  height: 80rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  background: #ffffff;
}

.input:focus {
  border-color: var(--primary);
}

.textarea {
  border: 2rpx solid var(--border-color);
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  background: #ffffff;
  min-height: 120rpx;
}

/* ===== Label ===== */
.label {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

/* ===== Tag/Badge ===== */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
}

.tag-running { background: #e6f7ff; color: #1890FF; }
.tag-paused { background: #fff7e6; color: #FA8C16; }
.tag-completed { background: #f6ffed; color: #52C41A; }
.tag-failed { background: #fff2f0; color: #FA5151; }
.tag-idle { background: #f5f5f5; color: #999999; }
.tag-cancelled { background: #f5f5f5; color: #999999; }

/* ===== Divider ===== */
.divider {
  height: 1rpx;
  background: var(--border-color);
  margin: 20rpx 0;
}

/* ===== Spacing Utilities ===== */
.mt-10 { margin-top: 10rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-30 { margin-top: 30rpx; }
.mb-10 { margin-bottom: 10rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mb-30 { margin-bottom: 30rpx; }
.ml-10 { margin-left: 10rpx; }
.mr-10 { margin-right: 10rpx; }
.p-20 { padding: 20rpx; }
.p-30 { padding: 30rpx; }

/* ===== Text Utilities ===== */
.text-center { text-align: center; }
.text-right { text-align: right; }
.text-bold { font-weight: 600; }
.text-sm { font-size: 24rpx; }
.text-lg { font-size: 36rpx; }
.text-xl { font-size: 44rpx; }
.text-muted { color: var(--text-muted); }

/* ===== Loading ===== */
.loading-more {
  text-align: center;
  padding: 20rpx;
  color: var(--text-muted);
  font-size: 24rpx;
}

.empty-state {
  text-align: center;
  padding: 80rpx 0;
  color: var(--text-muted);
  font-size: 28rpx;
}

/* ===== Scroll View ===== */
.scroll-y {
  height: 100%;
}

/* ===== Grid ===== */
.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.grid-3 {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 20rpx;
}

/* ===== Animation ===== */
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.pulse {
  animation: pulse 2s infinite;
}