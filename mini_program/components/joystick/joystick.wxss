/* components/joystick/joystick.wxss - Virtual joystick styles */

.joystick-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.joystick-base {
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: radial-gradient(circle, #f0f0f0 0%, #e0e0e0 100%);
  border: 4rpx solid #cccccc;
  position: relative;
  box-shadow: inset 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.joystick-knob {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #07C160, #06AD56);
  position: absolute;
  top: 50%;
  left: 50%;
  margin-left: -40rpx;
  margin-top: -40rpx;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.4);
  transition: none;
}

.joystick-labels {
  position: relative;
  width: 280rpx;
  height: 0;
}

.joystick-label {
  position: absolute;
  font-size: 22rpx;
  color: #999999;
}

.joystick-label.left {
  left: -40rpx;
  top: -160rpx;
}

.joystick-label.right {
  right: -40rpx;
  top: -160rpx;
}

.joystick-label.top {
  top: -300rpx;
  left: 50%;
  transform: translateX(-50%);
}

.joystick-label.bottom {
  top: -20rpx;
  left: 50%;
  transform: translateX(-50%);
}