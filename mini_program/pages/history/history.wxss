/* pages/history/history.wxss - History list styles */

.picker-value {
  height: 72rpx;
  line-height: 72rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
  color: #333333;
  text-align: center;
  background: #ffffff;
}

.sample-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.sample-item:last-child {
  border-bottom: none;
}

.sample-id {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
}

.sample-pos {
  margin-top: 4rpx;
}

.quality-score {
  font-size: 32rpx;
  font-weight: 700;
}