# =============================================================================
# 智能采样机械臂多智能体系统 - Docker 环境变量配置
# 复制此文件为 .env 并根据实际环境修改
# cp .env.example .env
# =============================================================================

# ---- 镜像标签 ----
IMAGE_TAG=latest

# ---- 日志级别 (DEBUG, INFO, WARNING, ERROR) ----
LOG_LEVEL=INFO

# ---- 服务端口 ----
API_PORT=8000
WS_PORT=8001

# ---- STM32 硬件串口配置 ----
# Raspberry Pi: /dev/serial0 或 /dev/ttyAMA0
# Windows 开发: COM4 等
# Docker 环境: /dev/serial0 (通过 devices 映射)
STM32_PORT=/dev/serial0
STM32_BAUDRATE=115200

# ---- OpenMV 相机串口配置 ----
# Docker 环境: /dev/ttyUSB0 (通过 devices 映射)
OPENMV_PORT=/dev/ttyUSB0

# ---- 数据库配置 ----
DATABASE_URL=sqlite:///./data/sampling.db

# ---- 云端同步配置（可选） ----
CLOUD_ENABLED=false
CLOUD_API_URL=https://api.example.com
CLOUD_SYNC_INTERVAL=60

# ---- CORS 配置 ----
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ---- 安全配置 ----
MAX_JOINT_VELOCITY=500
EMERGENCY_STOP_TIMEOUT_MS=100
WATCHDOG_INTERVAL_MS=50

# ---- 时区 ----
TZ=Asia/Shanghai

# ---- 循环工程训练配置 (Loop Engineering) ----
LOOP_ITERATIONS=10
LOOP_CONVERGENCE_PATIENCE=3
LOOP_ENABLED=true

# ---- Raspberry Pi 硬件配置 ----
# Pi 型号: auto (自动检测), pi3, pi4, pi5
RPI_MODEL=auto
# 分配给容器的内存 (MB): Pi 4 推荐 512M, Pi 5 推荐 768M
RPI_MEMORY_MB=512
RPI_MEMORY_LIMIT=512M
RPI_CPU_LIMIT=1.5
# UART 启用 (Pi 3/4/5 需要在 /boot/config.txt 中启用 enable_uart=1)
RPI_UART_ENABLED=true
# I2C 启用
RPI_I2C_ENABLED=true